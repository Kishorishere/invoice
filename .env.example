# --- AI provider (required) ---
GEMINI_API_KEY=

# Model ID — bump without code changes when Google revs the model.
# Known-good as of 2026-11: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite
# (gemini-2.5-* are decommissioned as of late 2026).
GEMINI_MODEL=gemini-3.6-flash

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=72

# Set to true when deployed over HTTPS (Fly.io). Dev stays on HTTP, so false here.
COOKIE_SECURE=false

# --- Database ---
# SQLite path (relative to backend/); use absolute path on Fly.io persistent volume
DATABASE_URL=sqlite:///./data/app.db

# --- CORS ---
# Comma-separated. Leave empty in production (single-container = same-origin).
CORS_ORIGINS=http://localhost:3005

# --- App ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# --- Admin bootstrap ---
# On startup, if these are set, the user with this email is created (if
# missing) or promoted to admin (if present). Leave blank to opt out.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-after-first-login
